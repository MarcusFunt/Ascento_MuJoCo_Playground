    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>
  <joint name="ascento/base_ascento/fixposition_link_joint" type="fixed">
    <parent link="ascento/base" />
    <child link="ascento/fixposition_link" />
    <origin rpy="0.0 0.0 0.0" xyz="0.1329 -0.0002 -0.08" />
  </joint>
  <link name="ascento/fixposition_link" />
  <link name="imu_link">
    <sensor name="ascento_imu" type="imu">
