    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.025 0.125" />
      <geometry>
        <box size="0.105 0.03    0.25" />
      </geometry>
    </collision>
  </link>
  <joint name="ascento/hip_right" type="revolute">
    <parent link="ascento/head" />
    <child link="ascento/thigh_right" />
    <axis xyz="0 1 0" />
    <origin rpy="0 0.0 -3.141592653589793" xyz="0 -0.1385 0" />
    <limit effort="40.0" velocity="4.0" lower="-4.71238898038469" upper="-1.5707963267948966" />
    <dynamics damping="0.0" friction="0.5" />
  </joint>
  <link name="ascento/shank_right">
    <inertial>
      <mass value="2.266" />
      <origin rpy="0 0 0" xyz="0.0 0.035 -0.188" />
      <inertia ixx="0.02432" ixy="8.147624e-06" ixz="-4.6438e-05" iyy="0.02544" iyz="0.002325" izz="0.003222" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.0175 0" />
      <geometry>
        <cylinder length="0.035" radius="0.067" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.025    -0.25" />
      <geometry>
        <cylinder length="0.04" radius="0.06" />
