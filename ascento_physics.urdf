  </link>
  <joint name="ascento/knee_right" type="revolute">
    <parent link="ascento/thigh_right" />
    <child link="ascento/shank_right" />
    <axis xyz="0 -1 0" />
    <origin rpy="0 0 0" xyz="0 0.073 0.25" />
    <limit effort="40.0" velocity="4.0" lower="-4.71238898038469" upper="-1.5707963267948966" />
    <dynamics damping="0.0" friction="0.5" />
  </joint>
  <link name="ascento/wheel_right">
    <inertial>
