      <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
      <inertia ixx="0.03891" ixy="9.9173e-08" ixz="1.4213893e-05" iyy="0.07635" iyz="-6.94705e-07" izz="0.03869" />
    </inertial>
    <collision>
