<?xml version='1.0' encoding='utf-8'?>
<robot name="ascento_mujoco">
  <!--Guard 2.0-oriented MuJoCo training copy. CAD masses/inertias retained. Finite leg travel and tyre contact added. No passive leg spring.-->
  <mujoco>
    <compiler meshdir="." strippath="false" discardvisual="true" balanceinertia="true" autolimits="true" />
    <option timestep="0.002" gravity="0 0 -9.81" />
    <default>
      <joint damping="0.45" frictionloss="0.04" armature="0.01" />
      <geom friction="1.1 0.01 0.001" condim="4" />
    </default>
    <actuator>
      <motor name="ascento_hip_left_motor" joint="ascento/hip_left" gear="1" ctrlrange="-40 40" />
      <motor name="ascento_knee_left_motor" joint="ascento/knee_left" gear="1" ctrlrange="-40 40" />
      <motor name="ascento_ankle_left_motor" joint="ascento/ankle_left" gear="1" ctrlrange="-8 8" />
      <motor name="ascento_hip_right_motor" joint="ascento/hip_right" gear="1" ctrlrange="-40 40" />
      <motor name="ascento_knee_right_motor" joint="ascento/knee_right" gear="1" ctrlrange="-40 40" />
      <motor name="ascento_ankle_right_motor" joint="ascento/ankle_right" gear="1" ctrlrange="-8 8" />
    </actuator>
  </mujoco>
  <material name="red">
    <color rgba="0.7 0.0 0.0 1.0" />
  </material>
  <material name="green">
    <color rgba="0.0 0.7 0.0 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.7 1.0" />
  </material>
  <material name="yellow">
    <color rgba="0.5 0.5 0.0 1.0" />
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0" />
  </material>
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.25 1.0" />
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0" />
  </material>
  <material name="light_grey">
    <color rgba="0.75 0.75 0.75 1.0" />
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <link name="base_link" />
  <joint name="base_link_ascento_joint" type="fixed">
    <parent link="base_link" />
    <child link="ascento/base" />
    <origin rpy="0.0 0.0 0.0" xyz="0 0 0.5" />
  </joint>
  <link name="ascento/base" />
  <link name="ascento/head">
    <inertial>
      <mass value="15.1" />
      <origin rpy="0 0 0" xyz="0.0007 0.0 -0.001" />
      <inertia ixx="0.1769" ixy="-0.001654" ixz="0.003713" iyy="0.185" iyz="0.001036" izz="0.2289" />
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.034" />
      <geometry>
        <box size="0.38 0.28 0.26" />
      </geometry>
    </collision>
  </link>
  <joint name="ascento/head_joint" type="fixed">
    <parent link="ascento/base" />
    <child link="ascento/head" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>
  <link name="ascento/thigh_left">
    <inertial>
      <mass value="3.783" />
      <origin rpy="0 0 0" xyz="0.0 0.038 0.212" />
      <inertia ixx="0.04102" ixy="-3.3856003e-05" ixz="-0.0001923" iyy="0.0464" iyz="-0.001653" izz="0.009405" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.024 0" />
      <geometry>
        <cylinder length="0.048" radius="0.082" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.03    0.25" />
      <geometry>
        <cylinder length="0.0825" radius="0.098" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.025 0.125" />
      <geometry>
        <box size="0.105 0.03    0.25" />
      </geometry>
    </collision>
  </link>
  <joint name="ascento/hip_left" type="revolute">
    <parent link="ascento/head" />
    <child link="ascento/thigh_left" />
    <axis xyz="0 -1 0" />
    <origin rpy="0 0 0" xyz="0 0.1385 0" />
    <limit effort="40.0" velocity="4.0" lower="-4.71238898038469" upper="-1.5707963267948966" />
    <dynamics damping="0.0" friction="0.5" />
  </joint>
  <link name="ascento/shank_left">
    <inertial>
      <mass value="2.266" />
      <origin rpy="0 0 0" xyz="0.0 0.035 -0.188" />
      <inertia ixx="0.02432" ixy="8.147624e-06" ixz="-4.6438e-05" iyy="0.02544" iyz="0.002325" izz="0.003222" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.0175 0" />
      <geometry>
        <cylinder length="0.035" radius="0.067" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.025    -0.25" />
      <geometry>
        <cylinder length="0.04" radius="0.06" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.02    -0.125" />
      <geometry>
        <box size="0.09         0.03         0.25" />
      </geometry>
    </collision>
  </link>
  <joint name="ascento/knee_left" type="revolute">
    <parent link="ascento/thigh_left" />
    <child link="ascento/shank_left" />
    <axis xyz="0 1 0" />
    <origin rpy="0 0 0" xyz="0 0.073 0.25" />
    <limit effort="40.0" velocity="4.0" lower="-4.71238898038469" upper="-1.5707963267948966" />
    <dynamics damping="0.0" friction="0.5" />
  </joint>
  <link name="ascento/wheel_left">
    <inertial>
      <mass value="1.712" />
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
      <inertia ixx="0.03891" ixy="9.9173e-08" ixz="1.4213893e-05" iyy="0.07635" iyz="-6.94705e-07" izz="0.03869" />
    </inertial>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.005" radius="0.25" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.06" radius="0.22" />
      </geometry>
    </collision>
  </link>
  <joint name="ascento/ankle_left" type="continuous">
    <parent link="ascento/shank_left" />
    <child link="ascento/wheel_left" />
    <origin xyz="0 0.075 -0.25" />
    <axis xyz="0 1 0" />
    <limit effort="8.0" velocity="10.0" />
    <dynamics damping="0.0" friction="0.2" />
  </joint>
  <link name="ascento/thigh_right">
    <inertial>
      <mass value="3.783" />
      <origin rpy="0 0 0" xyz="0.0 0.038 0.212" />
      <inertia ixx="0.04102" ixy="-3.3856003e-05" ixz="-0.0001923" iyy="0.0464" iyz="-0.001653" izz="0.009405" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.024 0" />
      <geometry>
        <cylinder length="0.048" radius="0.082" />
