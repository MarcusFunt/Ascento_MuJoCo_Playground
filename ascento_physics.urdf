    <origin rpy="0.0  0.0 -3.141592653" xyz="-0.157 0.0 0.006" />
  </joint>
  <link name="pinhole_camera_link" />
  <joint name="pinhole_camera_link_pinhole_color_frame_joint" type="fixed">
