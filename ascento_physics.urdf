    <parent link="realsense_d435i_front_link" />
    <child link="realsense_d435i_front_camera_color_frame" />
    <origin rpy="0.0 0.0 0.0" xyz="0.0149 0.0175 0.0125" />
  </joint>
  <link name="realsense_d435i_front_camera_color_frame" />
  <joint name="realsense_d435i_front_camera_color_frame_realsense_d435i_front_color_optical_frame_joint" type="fixed">
    <parent link="realsense_d435i_front_camera_color_frame" />
    <child link="realsense_d435i_front_color_optical_frame" />
    <origin rpy="-1.57079 0 -1.57079" xyz="0.0 0.0 0.0" />
  </joint>
  <link name="realsense_d435i_front_color_optical_frame" />
  <joint name="realsense_d435i_front_link_realsense_d435i_front_depth_frame_joint" type="fixed">
    <parent link="realsense_d435i_front_link" />
    <child link="realsense_d435i_front_depth_frame" />
    <origin rpy="0.0 0.0 0.0" xyz="0.0149 0.0175 0.0125" />
  </joint>
  <link name="realsense_d435i_front_depth_frame" />
  <joint name="realsense_d435i_front_depth_frame_realsense_d435i_front_depth_optical_frame_joint" type="fixed">
